# ─────────────────────────────────────────────────────────────
#  사경원 API 환경변수 (복사해서 .env 로 저장 후 값 채우기)
#  ※ .env 는 절대 깃허브에 올리지 마세요. (.gitignore 에 포함)
# ─────────────────────────────────────────────────────────────

#  운영 서버에서는 deploy/setup-server.sh 가 이 파일을 복사해 값(비밀번호 · 주소 등)을 자동으로 채웁니다.

NODE_ENV=development
# API 가 받는 주소 · 포트 (127.0.0.1 = 이 컴퓨터 안에서만 접속. 운영에서도 그대로 둡니다)
HOST=127.0.0.1
PORT=4000

# PostgreSQL 접속 주소
#  - 로컬 개발(Windows): PostgreSQL 설치 후 README 의 SQL 로 만든 계정 → 아래 값 그대로
#  - 운영 서버: setup-server.sh 가 임의 비밀번호로 만들어 넣습니다
DATABASE_URL=postgres://srmq:srmq@localhost:5432/srmq

# 로그인 토큰 서명용 비밀값 (32자 이상 임의 문자열)
#  생성:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 프론트엔드 주소 (메일 링크 · CORS · CSRF 검사에 사용)
#  - 로컬: http://localhost:5173
#  - 운영: https://www.srmq.or.kr
APP_ORIGIN=http://localhost:5173
# 프론트를 여러 주소에서 띄울 때만 (쉼표로 구분) 예: https://srmq.or.kr,https://srmq-web.vercel.app
EXTRA_ALLOWED_ORIGINS=

# 로그인 쿠키 (같은 도메인에서 /api 로 운영하면 기본값 그대로)
#  프론트(Vercel)와 API(오라클)가 서로 다른 사이트 주소라면 COOKIE_SAMESITE=none 로 바꿔야 합니다.
COOKIE_SAMESITE=lax
COOKIE_SECURE=
COOKIE_DOMAIN=

# ── 토스페이먼츠 (개발자센터 > API 키 > 결제위젯 연동 키) ──
#  테스트 키(test_gck_ / test_gsk_)는 가입 즉시 발급, 라이브 키는 PG 계약 · 심사 후 발급
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 0원 테스트 결제 ──
#  true 로 바꾸면 결제 화면에 '0원 테스트 결제'가 생깁니다. 사업자등록(PG 계약) 없이 결제 → 회원 자격 반영을 시험할 때만 쓰고,
#  실제 오픈 전에는 반드시 false 로 되돌리세요. (운영 서버에서 켜면 누구나 회비 없이 회원이 될 수 있습니다)
TEST_PAYMENT_ENABLED=false

# ── 무통장입금 계좌 (기부금후원 페이지와 같은 계좌) ──
BANK_NAME=KB국민은행
BANK_ACCOUNT_NUMBER=821301-00-058386
BANK_ACCOUNT_HOLDER=(사)사회적책임경영품질원
BANK_TRANSFER_DUE_DAYS=7

# ── 업로드 이미지 저장 위치 ── (로컬: server/uploads · 운영: /srv/srmq/uploads)
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE=/uploads
UPLOAD_MAX_MB=15

# ── 메일 발송 (비밀번호 재설정 · 입금 안내 · 결제 완료) ──
#  비워 두면 메일 대신 서버 로그에 내용이 찍힙니다.
#  예) 네이버웍스: smtp.worksmobile.com / 465 / SMTP_SECURE=true
#      Gmail(앱 비밀번호): smtp.gmail.com / 465 / SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=사회적책임경영품질원 <srmq@srmq.or.kr>
# 무통장입금 신청이 들어오면 알림을 받을 사무국 메일
ADMIN_NOTIFY_EMAIL=srmq@srmq.or.kr
