# 사경원 API 를 서버 부팅 때 자동으로 실행하는 systemd 설정 틀
# setup-server.sh 가 __...__ 자리를 채워 /etc/systemd/system/srmq-api.service 로 복사합니다.
#   상태:  systemctl status srmq-api      로그:  journalctl -u srmq-api -f
#   재시작: sudo systemctl restart srmq-api
[Unit]
Description=SRMQ API (Node.js)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__/server
# 설정값은 server/.env 에서 읽습니다
Environment=NODE_ENV=production
Environment=TZ=Asia/Seoul
ExecStart=__NODE_BIN__ src/server.js
Restart=always
RestartSec=3
TimeoutStopSec=15

# 보안: 시스템 폴더 · 홈 폴더는 읽기 전용, 임시 폴더 분리
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
